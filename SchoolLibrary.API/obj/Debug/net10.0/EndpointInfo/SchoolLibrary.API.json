  "components": {
    "schemas": {
      "AuthorCreateDto": {
        "required": [
          "firstName",
          "lastName",
          "middleName",
          "pseudonym"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "middleName": {
            "type": [
              "null",
              "string"
            ]
          },
          "pseudonym": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BookCreateDto": {
        "required": [
          "title",
          "authorIds",
          "publishedYear",
          "price",
          "description"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "authorIds": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "publishedYear": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateGradeDto": {
        "required": [
          "number",
          "letter"
        ],
        "type": "object",
        "properties": {
          "number": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "uint8"
          },
          "letter": {
            "type": "string"
          }
        }
      },
      "FullName": {
        "required": [
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "middleName": {
            "type": [
              "null",
              "string"
            ],
            "default": ""
          },
          "full": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FundCreateDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "OperationType": {
        "type": "integer"
      },
      "UserCreateDto": {
        "required": [
          "lastName",
          "firstName",
          "password",
          "role",
          "middleName",
          "username",
          "email"
        ],
        "type": "object",
        "properties": {
          "lastName": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "middleName": {
            "type": [
              "null",
              "string"
            ]
          },
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UserHistoryCreateDto": {
        "required": [
          "userId",
          "libraryItemCopyId",
          "operationType"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "libraryItemCopyId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "operationType": {
            "$ref": "#/components/schemas/OperationType"
          }
        }
      },
      "UserLoginDto": {
        "required": [
          "identifier",
          "password"
        ],
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserRegisterDto": {
        "required": [
          "username",
          "email",
          "password",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": "string"
          },
          "fullName": {
            "$ref": "#/components/schemas/FullName"
          }
        }
      }
    }
  },
