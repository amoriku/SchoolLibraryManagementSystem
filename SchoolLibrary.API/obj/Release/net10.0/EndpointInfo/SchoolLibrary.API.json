  "components": {
    "schemas": {
      "AuthorCreateDto": {
        "required": [
          "pseudonym",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "pseudonym": {
            "type": [
              "null",
              "string"
            ]
          },
          "fullName": {
            "$ref": "#/components/schemas/FullName"
          }
        }
      },
      "BookCreateDto": {
        "required": [
          "title",
          "authorIds",
          "publishedYear",
          "price",
          "description"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "authorIds": {
            "type": "array",
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "publishedYear": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FullName": {
        "required": [
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "middleName": {
            "type": [
              "null",
              "string"
            ],
            "default": ""
          },
          "full": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FundCreateDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "OperationType": {
        "type": "integer"
      },
      "UserHistoryCreateDto": {
        "required": [
          "userId",
          "libraryItemCopyId",
          "operationType"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "libraryItemCopyId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "operationType": {
            "$ref": "#/components/schemas/OperationType"
          }
        }
      },
      "UserLoginDto": {
        "required": [
          "identifier",
          "password"
        ],
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UserRegisterDto": {
        "required": [
          "username",
          "email",
          "password",
          "fullName"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": "string"
          },
          "fullName": {
            "$ref": "#/components/schemas/FullName"
          }
        }
      }
    }
  },
  "tags": [
    {
